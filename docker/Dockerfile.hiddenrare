# syntax=docker/dockerfile:1
# Our method and the evaluation: hiddenrare/, eval/, data/, part1/ viewers and the notebooks.
# Built by .github/workflows/build-images.yml.
#
#   docker build -f docker/Dockerfile.hiddenrare -t ghcr.io/fpera0248/recomb2027-hiddenrare:latest .
#   docker run -v "$PWD/out":/out ghcr.io/fpera0248/recomb2027-hiddenrare:latest \
#       env ASSETS=/out/assets OUT=/out/reproduce_out reproduce paper

FROM python:3.12-slim-bookworm
ENV DEBIAN_FRONTEND=noninteractive PIP_NO_CACHE_DIR=1 PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates git build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/recomb2027
COPY requirements.txt .
RUN pip install -r requirements.txt

COPY . /opt/recomb2027
RUN chmod +x reproduce.sh fetch_data.sh && ln -sf /opt/recomb2027/reproduce.sh /usr/local/bin/reproduce

LABEL org.opencontainers.image.source="https://github.com/fpera0248/recomb2027"
CMD ["/bin/bash"]
