# syntax=docker/dockerfile:1
# Our method and the evaluation: hiddenrare/, eval/, data/, the part1/ result-table readers and the notebooks.
# Built by .github/workflows/build-images.yml.
#
#   docker build -f docker/Dockerfile.hiddenrare -t recomb2027-hiddenrare .
#   docker run -v "$PWD/out":/out recomb2027-hiddenrare \
#       env ASSETS=/out/assets OUT=/out/reproduce_out reproduce paper
# (local build; the pinned published image is ghcr.io/fpera0248/recomb2027-hiddenrare:v0.1.0, see CONTAINER.md)

FROM python:3.12-slim-bookworm
ENV DEBIAN_FRONTEND=noninteractive PIP_NO_CACHE_DIR=1 PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates git build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/recomb2027
COPY requirements.txt .
RUN pip install -r requirements.txt

COPY . /opt/recomb2027
RUN chmod +x reproduce.sh fetch_data.sh && printf '#!/bin/sh\nexec /opt/recomb2027/reproduce.sh "$@"\n' > /usr/local/bin/reproduce && chmod +x /usr/local/bin/reproduce

LABEL org.opencontainers.image.source="https://github.com/fpera0248/recomb2027"
CMD ["/bin/bash"]
